{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@healt/*": ["src/healt/*"],
      "@auth/*": ["src/auth/*"],
      "@products/*": ["src/products/*"],
      "@reports/*": ["src/reports/*"],
      "@shared/*": ["src/shared/*"],
      "@swagger/*": ["swagger/*"],
    }
  }
}
